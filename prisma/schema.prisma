generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user") // user | admin
  wallet    Int      @default(0)
  status    String   @default("active")  // active | banned
  shopStatus String  @default("pending") // pending | verified | rejected (xác minh shop)
  createdAt DateTime @default(now())
  products  Product[]
  buys      Order[]  @relation("buyer")
  sells     Order[]  @relation("seller")
  txns      Txn[]
  reviewsWritten  Review[] @relation("author")
  reviewsReceived Review[] @relation("target")
  msgSent   Message[] @relation("msgFrom")
  msgRecv   Message[] @relation("msgTo")
  violations Violation[]
  consignments Consignment[]
}

model Product {
  id          Int      @id @default(autoincrement())
  sellerId    Int
  seller      User     @relation(fields: [sellerId], references: [id])
  title       String
  brand       String
  size        String
  measures    String   // so do thuc te: ngực/vai/dài...
  material    String   @default("")
  category    String   @default("khac") // thun | somi | jeans | khoac | phukien | khac
  condition   String   // NEW | GOOD | FAIR | FLAW
  price       Int
  description String   @default("")
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED | RESERVED | SOLD
  createdAt   DateTime @default(now())
  images      Image[]
  consigned   Boolean  @default(false) // hàng ký gửi (hoa hồng riêng)
  items       OrderItem[]
  violations  Violation[]
}

model Image {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
}

model Order {
  id         Int      @id @default(autoincrement())
  buyerId    Int
  sellerId   Int
  buyer      User     @relation("buyer", fields: [buyerId], references: [id])
  seller     User     @relation("seller", fields: [sellerId], references: [id])
  total      Int
  commission Int
  address    String
  status     String   @default("PENDING_PAYMENT")
  discount   Int      @default(0)
  couponCode String?
  carrier    String?  // ghn | ghtk | viettel
  shippingFee Int     @default(0)
  trackingCode String?
  shipDeadline DateTime? // hạn người bán phải gửi hàng
  shippedAt  DateTime?
  receivedAt DateTime?
  createdAt  DateTime @default(now())
  items      OrderItem[]
  dispute    Dispute?
  review     Review?
  txns       Txn[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  price     Int
}

model Txn {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  orderId   Int?
  order     Order?   @relation(fields: [orderId], references: [id])
  type      String   // HOLD | RELEASE | REFUND | WITHDRAW
  amount    Int
  createdAt DateTime @default(now())
}

model Dispute {
  id        Int      @id @default(autoincrement())
  orderId   Int      @unique
  order     Order    @relation(fields: [orderId], references: [id])
  reason    String
  status    String   @default("OPEN") // OPEN | RESOLVED
  decision  String?  // REFUND | RELEASE
  note      String?
  evidence  String   @default("") // đường dẫn ảnh/video, ngăn cách bằng dấu phẩy
  createdAt DateTime @default(now())
}

model Review {
  id        Int      @id @default(autoincrement())
  orderId   Int      @unique
  order     Order    @relation(fields: [orderId], references: [id])
  authorId  Int
  author    User     @relation("author", fields: [authorId], references: [id])
  sellerId  Int
  seller    User     @relation("target", fields: [sellerId], references: [id])
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now())
}

model Category {
  id     Int     @id @default(autoincrement())
  key    String  @unique
  name   String
  active Boolean @default(true)
}

model Coupon {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  type      String    // percent | fixed
  value     Int
  minOrder  Int       @default(0)
  maxUses   Int       @default(0) // 0 = không giới hạn
  used      Int       @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Sale {
  id       Int      @id @default(autoincrement())
  name     String
  percent  Int
  category String?  // null = tất cả danh mục
  startsAt DateTime
  endsAt   DateTime
  active   Boolean  @default(true)
}

model Setting {
  key   String @id
  value String
}

model Message {
  id        Int       @id @default(autoincrement())
  fromId    Int
  from      User      @relation("msgFrom", fields: [fromId], references: [id])
  toId      Int
  to        User      @relation("msgTo", fields: [toId], references: [id])
  productId Int?
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model Violation {
  id         Int      @id @default(autoincrement())
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  reporterId Int
  reporter   User     @relation(fields: [reporterId], references: [id])
  reason     String
  status     String   @default("OPEN") // OPEN | RESOLVED
  createdAt  DateTime @default(now())
}

model Consignment {
  id            Int      @id @default(autoincrement())
  sellerId      Int
  seller        User     @relation(fields: [sellerId], references: [id])
  title         String
  brand         String
  size          String
  measures      String
  category      String
  condition     String
  expectedPrice Int
  description   String   @default("")
  images        String   @default("")
  status        String   @default("SUBMITTED") // SUBMITTED | RECEIVED | REJECTED | LISTED | SOLD | EXPIRED | RETURNED
  productId     Int?
  finalPrice    Int?
  adminNote     String?
  listedAt      DateTime?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
}
